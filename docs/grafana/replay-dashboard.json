{
  "title": "Notification Replay Dashboard",
  "uid": "notification-replay",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [{ "name": "datasource", "label": "Prometheus", "type": "datasource", "query": "prometheus", "refresh": 1 }] },
  "panels": [
    { "id": 1, "title": "Failed Events Awaiting Replay", "type": "stat", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 }, "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "replay_failed_events", "refId": "A" }] },
    { "id": 2, "title": "Replay Successes per Second", "type": "timeseries", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 }, "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "rate(replay_success_total[5m])", "refId": "A" }] },
    { "id": 3, "title": "Replay Failures per Second", "type": "timeseries", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 }, "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "rate(replay_failure_total[5m])", "refId": "A" }] }
  ]
}
