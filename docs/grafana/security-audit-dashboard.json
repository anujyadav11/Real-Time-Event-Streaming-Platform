{
  "title": "Security and Audit Dashboard",
  "uid": "security-audit",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [{ "name": "datasource", "label": "Prometheus", "type": "datasource", "query": "prometheus", "refresh": 1 }] },
  "panels": [
    { "id": 1, "title": "Refresh Token Success Rate", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }, "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "rate(auth_refresh_success_total[5m])", "refId": "A" }, { "expr": "rate(auth_refresh_failure_total[5m])", "refId": "B" }] },
    { "id": 2, "title": "Active Refresh Token Sessions", "type": "stat", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }, "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "auth_active_sessions", "refId": "A" }] },
    { "id": 3, "title": "Audit Events by Outcome", "type": "timeseries", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }, "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "sum by(outcome) (rate(audit_events_processed_total[5m]))", "refId": "A" }] }
  ]
}
